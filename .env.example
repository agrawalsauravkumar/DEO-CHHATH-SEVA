# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ================================================================
# DEO CHHATH SEVA - PRODUCTION & CLOUD ENVIRONMENT CONFIGURATION
# Organization: NEXTGEN DEVBHOOMI FOUNDATION
# Tagline: "रास्ता भी • सहायता भी • सेवा भी"
# ================================================================

# Server Port and Node Environment
PORT=3000
NODE_ENV=production

# PostgreSQL + PostGIS Connection String
# Example: postgresql://username:password@hostname:5432/deo_chhath_db?sslmode=require
DATABASE_URL="postgresql://deo_user:placeholder_password@localhost:5432/deo_chhath_db"

# HMAC signing secret for session and admin authentication tokens.
# Generate a private random value of at least 32 characters; do not use this placeholder.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Administrator Initial Account Bootstrapping (for production setup)
ADMIN_INITIAL_EMAIL="admin@nextgendevbhoomi.org"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# Persistent Team Photo Storage Directory
# Mount persistent disk or volume in production (e.g. /app/data/team-images or relative data/team-images)
TEAM_IMAGE_DIR="data/team-images"

# Public browser map configuration. Leaflet uses the OSM standard tile service.
# Facility API must be an authorized source returning verified MapFacility records.
# Leave blank until that real source is configured; the local seeded API is not suitable.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_FACILITIES_API_URL=

# Optional authorized announcement feed. Each announcement must include isVerifiedOfficial=true,
# an authoritative non-demo source, isActive=true, and an ISO-8601 expiresAt value.
VITE_VERIFIED_ANNOUNCEMENTS_API_URL=

# Required when building the native Android app; use the deployed API origin without a trailing slash.
VITE_API_BASE_URL=

# Routing requests use the public Valhalla OpenStreetMap-compatible service by default.
# Override with a public endpoint or a same-origin server proxy; never put private API keys in VITE_ variables.
VITE_ROUTING_PROVIDER="VALHALLA"
VITE_ROUTING_ENGINE_URL="https://valhalla1.openstreetmap.de"

# SMS / OTP Provider (Fast2SMS, Twilio, MSG91 for real SMS dispatch)
SMS_PROVIDER="fast2sms"
SMS_API_KEY="placeholder_sms_api_key"
SMS_API_URL=
SMS_SENDER_ID="DEOSEV"
# Set OTP_DEV_MODE=true only with NODE_ENV=development for local testing.
OTP_DEV_MODE=false

# Emergency Broadcast Notification Webhook
NOTIFICATION_CONFIG="placeholder_notification_endpoint"

# Comma-separated allowed browser origins, including Capacitor's https://localhost origin.
CORS_ORIGIN="https://localhost"
