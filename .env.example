# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ================================================================
# DEO CHHATH SEVA - PRODUCTION & CLOUD ENVIRONMENT CONFIGURATION
# Organization: NEXTGEN DEVBHOOMI FOUNDATION
# Tagline: "रास्ता भी • सहायता भी • सेवा भी"
# ================================================================

# Server Port and Node Environment
PORT=3000
NODE_ENV=production

# PostgreSQL + PostGIS Connection String
# Example: postgresql://username:password@hostname:5432/deo_chhath_db?sslmode=require
DATABASE_URL="postgresql://deo_user:placeholder_password@localhost:5432/deo_chhath_db"

# JWT Secret for Session & Admin Authentication Tokens
AUTH_SECRET="deo_chhath_seva_super_secret_jwt_key_placeholder"

# Map Provider Configuration (OpenStreetMap by default, supports CARTO, Mapbox, TileHost)
MAP_PROVIDER="osm"
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_ATTRIBUTION="© OpenStreetMap contributors | NextGen Dev Bhoomi Foundation"
MAP_PROVIDER_KEY="placeholder_map_key"

# Routing Provider Configuration (OSRM default; Mapbox / GraphHopper fallback)
ROUTING_PROVIDER_KEY="placeholder_routing_key"
ROUTING_ENGINE_URL="https://router.project-osrm.org"

# SMS / OTP Provider (Fast2SMS, Twilio, MSG91 for real SMS dispatch)
SMS_PROVIDER="fast2sms"
SMS_API_KEY="placeholder_sms_api_key"
SMS_SENDER_ID="DEOSEV"

# Emergency Broadcast Notification Webhook
NOTIFICATION_CONFIG="placeholder_notification_endpoint"

# CORS Origin for production API lockdown
CORS_ORIGIN="*"
